# The Blue Alliance read key (thebluealliance.com/account)
TBA_KEY=
# Events to follow, comma-separated. Each needs a camera calibration in
# app/events/<key>/camera.json or data/events/<key>/camera.json (see README).
EVENTS=2026wasam
POLL_SECONDS=120
# which GPU inside the container (0 = first)
GPU_DEVICE=0
TZ=America/Los_Angeles
# files in ./data are owned by this host user (id -u / id -g)
PUID=1000
PGID=1000
# where match videos are kept for the in-browser analysis player (~100 MB/match); put it on a big disk
MEDIA_DIR=./data/media
# yt-dlp over IPv4 only (YouTube bot-checks this server's IPv6). Set 0 to disable.
YT_FORCE_IPV4=1
