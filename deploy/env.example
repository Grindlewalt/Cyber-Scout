# Cyber-Scout infrastructure settings. Everything else (TBA key, team, events, GPU/HUBCAM options, accounts)
# is configured in the web app and stored in data/app.db.
# web port on this machine
WEB_PORT=7560
# files in ./data are owned by this host user (id -u / id -g)
PUID=1000
PGID=1000
TZ=America/Los_Angeles
# where match videos are kept for the in-browser analysis player (~100 MB/match); put it on a big disk
MEDIA_DIR=./data/media
# yt-dlp over IPv4 only (YouTube sometimes bot-checks IPv6). Set 0 to disable.
YT_FORCE_IPV4=1
# CPU-only machine (no NVIDIA container toolkit): uncomment
#COMPOSE_FILE=docker-compose.yml:docker-compose.cpu.yml
# Session cookies: auto = Secure when a TLS proxy in front sends X-Forwarded-Proto: https; 1 = always; 0 = never
#COOKIE_SECURE=auto
# PAUSE_PROCESSING=1 keeps the worker running (Video page jobs: frame grabs, layout suggestions, calibration fits)
# without processing any matches.
# PAUSE_PROCESSING=1
# Live-stream recorder (service `recorder`): LIVESTREAM=0 disables it. Disk: per-stream budget for segments+clips
# (GB, under MEDIA_DIR/live), and the free space it keeps on that disk by deleting old segments of finished streams.
#LIVESTREAM=1
#LIVE_BUDGET_GB=60
#LIVE_MIN_FREE_GB=30
