#!/usr/bin/env bash
# Cyber-Scout Client install from @SITE@ (code @SHA@, @DAY@): macOS and Linux.
#   curl -fsSL @SITE@/downloads/get-client.sh | bash
#   curl -fsSL @SITE@/downloads/get-client.sh | bash -s -- --server http://<your server>:7560
# Downloads this computer's Client build from the site, checks it against the SHA-256 below (written when the site was
# published), installs it to ~/CyberScout, starts it at login (macOS: a LaunchAgent; Linux: a systemd user service)
# and opens it in the browser. Run it again to update. Options (or the variable in brackets):
#   --server URL      your Cyber-Scout server, set on the first install [CS_SERVER] (this site's default: @SERVER_SHOWN@)
#   --dir DIR         where the program goes [CS_CLIENT_DIR] (~/CyberScout)
#   --data DIR        the Client's data folder [CS_CLIENT_DATA] (default: the Client's own)
#   --port N          local port [CS_CLIENT_PORT] (7600)
#   --no-autostart    don't start it at login (it still starts now)
#   --no-open         don't open the browser
#   --uninstall       stop it, remove the program and the login item (the data folder stays)
# Reached this site at another address?  curl -fsSL <that address>/downloads/get-client.sh | CS_SITE=<that address> bash
# Generated from site/tools/get-client.sh.in by site/tools/publish_downloads.sh.
set -euo pipefail

main() {
  SITE="${CS_SITE:-@SITE@}"; SITE="${SITE%/}"
  SERVER="${CS_SERVER:-@SERVER@}"; SERVER_SET=0; [ -n "${CS_SERVER:-}" ] && SERVER_SET=1
  DIR="${CS_CLIENT_DIR:-$HOME/CyberScout}"; DATA="${CS_CLIENT_DATA:-}"; PORT="${CS_CLIENT_PORT:-7600}"
  AUTO=1; OPEN=1; UNINSTALL=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) need "$@"; SERVER="$2"; SERVER_SET=1; shift 2;;
      --server=*) SERVER="${1#*=}"; SERVER_SET=1; shift;;
      --dir) need "$@"; DIR="$2"; shift 2;;      --dir=*) DIR="${1#*=}"; shift;;
      --data) need "$@"; DATA="$2"; shift 2;;    --data=*) DATA="${1#*=}"; shift;;
      --port) need "$@"; PORT="$2"; shift 2;;    --port=*) PORT="${1#*=}"; shift;;
      --no-autostart) AUTO=0; shift;;
      --no-open) OPEN=0; shift;;
      --uninstall) UNINSTALL=1; shift;;
      -h|--help) echo "options: --server URL  --dir DIR  --data DIR  --port N  --no-autostart  --no-open  --uninstall"
                 echo "(details: the top of $SITE/downloads/get-client.sh)"; return 0;;
      *) die "unknown option: $1 (try --help)";;
    esac
  done
  SERVER="${SERVER%/}"
  [[ "$PORT" =~ ^[0-9]{2,5}$ ]] && [ "$PORT" -le 65535 ] || die "bad --port: $PORT"
  [ -z "$SERVER" ] || [[ "$SERVER" =~ ^https?://[A-Za-z0-9.:\[\]_-]+(/[A-Za-z0-9._~/-]*)?$ ]] ||
    die "--server must look like http://10.0.0.58:7560 or https://scout.example.org, got: $SERVER"
  case "$DIR" in /*) ;; *) DIR="$PWD/$DIR";; esac
  [ -z "$DATA" ] || case "$DATA" in /*) ;; *) DATA="$PWD/$DATA";; esac
  for p in "$DIR" "$DATA"; do                # they go into a plist / unit file as-is
    [[ "$p" != *[\&\<\>\"\'\\%\$\`]* ]] || die "please pick a folder name without & < > \" ' \\ % \$ or \`: $p"
  done

  OS="$(uname -s)"; ARCH="$(uname -m)"
  LABEL=com.cyberscout.client; PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
  UNIT=cyberscout-client.service; UDIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
  BIN="$DIR/cyberscout-client"; LOG="$DIR/logs/client.out"
  if [ -n "$DATA" ]; then DDIR="$DATA"
  elif [ "$OS" = Darwin ]; then DDIR="$HOME/Library/Application Support/CyberScout"
  else DDIR="${XDG_DATA_HOME:-$HOME/.local/share}/cyberscout"; fi

  if [ "$UNINSTALL" = 1 ]; then
    stop_running
    rm -f "$PLIST"
    if user_systemd; then systemctl --user disable "$UNIT" >/dev/null 2>&1 || true; rm -f "$UDIR/$UNIT"
      systemctl --user daemon-reload >/dev/null 2>&1 || true; fi
    rm -f "$BIN"; rmdir "$DIR/logs" "$DIR" 2>/dev/null || true
    bold "Removed the Cyber-Scout Client."
    info "Its data folder stays: $DDIR (your local copy of the server's data and any changes not sent yet)."
    return 0
  fi

  F=""; H=""
  case "$OS" in
    Darwin)
      [ "$(sysctl -n hw.optional.arm64 2>/dev/null || echo 0)" = 1 ] && ARCH=arm64     # also under Rosetta
      case "$ARCH" in arm64) F=cyberscout-client-macos-arm64; H="@SHA_macos_arm64@";;
                      x86_64) F=cyberscout-client-macos-x64; H="@SHA_macos_x64@";; esac;;
    Linux)
      case "$ARCH" in x86_64|amd64) F=cyberscout-client-linux-x64; H="@SHA_linux_x64@";; esac;;
  esac
  [ -n "$F" ] || die "there's no Cyber-Scout Client for $OS $ARCH. On a phone or tablet, open your server's address in the browser instead."
  [ -n "$H" ] || die "this site has no $F yet: download it from $SITE once it's published"
  have curl || die "curl is needed"

  bold "Cyber-Scout Client ($F) from $SITE"
  mkdir -p "$DIR/logs"
  TMP="$(mktemp "$DIR/.download.XXXXXX")"; trap 'rm -f "$TMP"' EXIT
  curl -fL --retry 3 --progress-bar "$SITE/downloads/$F" -o "$TMP" ||
    die "couldn't download $SITE/downloads/$F: is this computer on a network that can reach $SITE?"
  GOT="$( (sha256sum "$TMP" 2>/dev/null || shasum -a 256 "$TMP") | cut -d' ' -f1)"
  [ "$GOT" = "$H" ] || die "$F: SHA-256 $GOT isn't the published $H: not installing it"
  chmod 755 "$TMP"
  [ "$OS" = Darwin ] && { xattr -d com.apple.quarantine "$TMP" 2>/dev/null || true; }
  stop_running                                 # an older copy holds the port and the data folder
  mv -f "$TMP" "$BIN"
  info "installed $BIN"

  if [ -n "$SERVER" ]; then
    if [ ! -e "$DDIR/config.json" ]; then
      (umask 077; mkdir -p "$DDIR"; printf '{"server": "%s"}\n' "$SERVER" > "$DDIR/config.json")
      info "server: $SERVER (change it later in the Client: Settings, Connection)"
    elif [ "$SERVER_SET" = 1 ]; then
      info "kept the server already set in the Client: change it there (Settings, Connection) to use $SERVER"
    fi
  fi

  ARGS=(--no-browser)
  [ "$PORT" = 7600 ] || ARGS+=(--port "$PORT")
  [ -z "$DATA" ] || ARGS+=(--data "$DATA")
  HOW=""
  if [ "$AUTO" = 1 ] && [ "$OS" = Darwin ]; then
    mkdir -p "$(dirname "$PLIST")"
    {
      echo '<?xml version="1.0" encoding="UTF-8"?>'
      echo '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">'
      echo '<plist version="1.0"><dict>'
      echo "  <key>Label</key><string>$LABEL</string>"
      echo "  <key>ProgramArguments</key><array><string>$BIN</string>$(printf '<string>%s</string>' "${ARGS[@]}")</array>"
      echo '  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/><key>ThrottleInterval</key><integer>10</integer>'
      echo '  <key>ProcessType</key><string>Interactive</string>'
      echo "  <key>StandardOutPath</key><string>$LOG</string><key>StandardErrorPath</key><string>$LOG</string>"
      echo '</dict></plist>'
    } > "$PLIST"
    launchctl bootstrap "gui/$(id -u)" "$PLIST" || die "launchctl couldn't start it (see $PLIST)"
    HOW="starts at login (LaunchAgent $LABEL)"
  elif [ "$AUTO" = 1 ] && user_systemd; then
    mkdir -p "$UDIR"
    {
      echo "[Unit]"; echo "Description=Cyber-Scout Client"; echo "After=network-online.target"; echo
      echo "[Service]"; echo "ExecStart=\"$BIN\"$(printf ' "%s"' "${ARGS[@]}")"
      echo "Restart=on-failure"; echo "RestartSec=10"; echo
      echo "[Install]"; echo "WantedBy=default.target"
    } > "$UDIR/$UNIT"
    systemctl --user daemon-reload && systemctl --user enable --now "$UNIT" >/dev/null 2>&1 ||
      die "systemd couldn't start it (systemctl --user status $UNIT)"
    HOW="starts at login (systemd user service $UNIT; stops when you log out)"
  else
    nohup "$BIN" "${ARGS[@]}" >>"$LOG" 2>&1 </dev/null &
    disown 2>/dev/null || true
    HOW="running now; start it again after a restart with: $BIN"
  fi

  URL="http://127.0.0.1:$PORT/"
  for _ in $(seq 1 40); do curl -fs -o /dev/null "$URL" && break; sleep 0.5; done
  curl -fs -o /dev/null "$URL" || die "it didn't answer on $URL yet: see $LOG"
  if [ "$OPEN" = 1 ]; then
    if [ "$OS" = Darwin ]; then open "$URL" || true
    elif [ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" ] && have xdg-open; then (xdg-open "$URL" >/dev/null 2>&1 &) || true; fi
  fi
  echo
  bold "Cyber-Scout Client is running: $URL"
  info "$HOW"
  if [ -n "$SERVER" ]; then info "sign in with your Cyber-Scout account and it syncs with the server"
  else info "first: Settings, Connection: type your server's address (the server installer printed it)"; fi
  info "data: $DDIR   log: $LOG"
  info "update: run the same command again   remove: curl -fsSL $SITE/downloads/get-client.sh | bash -s -- --uninstall"
}

stop_running() {
  if [ "$OS" = Darwin ]; then launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
  elif user_systemd; then systemctl --user stop "$UNIT" 2>/dev/null || true; fi
  local pids; pids="$(pgrep -f "$BIN" 2>/dev/null || true)"          # one started by hand / --no-autostart
  [ -z "$pids" ] || kill $pids 2>/dev/null || true
  for _ in $(seq 1 20); do pgrep -f "$BIN" >/dev/null 2>&1 || break; sleep 0.25; done
}
user_systemd() { have systemctl && systemctl --user show-environment >/dev/null 2>&1; }
need() { [ $# -ge 2 ] || die "$1 needs a value"; }
have() { command -v "$1" >/dev/null 2>&1; }
bold() { printf '\033[1m%s\033[0m\n' "$*"; }
info() { printf '  %s\n' "$*"; }
die() { printf '\033[31mx %s\033[0m\n' "$*" >&2; exit 1; }

main "$@"
